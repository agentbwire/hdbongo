# Copy these into Vercel -> Project -> Settings -> Environment Variables.
# Never commit real values, and never paste them into a chat window.

# From your Mongike dashboard (starts with mk_live_)
MONGIKE_API_KEY=mk_live_xxxxxxxxxxxxxxxxx

# Your live site, used to build the payment confirmation webhook address
SITE_URL=https://your-project.vercel.app

# Firebase server access — used only by the three /api/payments files so a
# confirmed payment can switch the package on. Download from
# Firebase console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"hdbongoclub",...}

# ...or use the same values individually instead of the JSON blob above:
FIREBASE_PROJECT_ID=hdbongoclub
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@hdbongoclub.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
